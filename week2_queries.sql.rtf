\f0\fs24 \cf0 CREATE TABLE omnichannel_sales (\
    Order_ID VARCHAR(50) PRIMARY KEY,\
    Order_Date DATE,\
    Customer_Name VARCHAR(100),\
    Region VARCHAR(50),\
    Salesperson VARCHAR(100),\
    Product VARCHAR(100),\
    Quantity INT,\
    Unit_Price NUMERIC(10, 2),\
    Total_Sales NUMERIC(12, 2),\
    Payment_Method VARCHAR(50),\
    Sales_Channel VARCHAR(50),\
    Store_Type VARCHAR(50),\
    Platform VARCHAR(50),\
    Delivery_Type VARCHAR(50),\
    Device_Type VARCHAR(50),\
    Year INT,\
    Month INT,\
    Month_Name VARCHAR(50),\
    Day_Name VARCHAR(50)\
);\
\
SELECT COUNT(*) FROM omnichannel_sales;\
\
--Identifying three major business factssuch as Total revenue, total Quantity and Average Order Value (AOV)\
\
SELECT \
    SUM(Total_Sales) AS total_revenue,\
    SUM(Quantity) AS total_items_sold,\
    ROUND(AVG(Total_Sales), 2) AS average_order_value\
FROM omnichannel_sales;\
\
-- finding Best-Selling Products by Volume\
\
SELECT \
    Product,\
    SUM(Quantity) AS total_units_sold,\
    SUM(Total_Sales) AS total_revenue\
FROM omnichannel_sales\
GROUP BY Product\
ORDER BY total_units_sold DESC;\
\
\
-- Geographical Sales distribution\
\
SELECT \
    Region,\
    SUM(Total_Sales) AS regional_revenue,\
    ROUND((SUM(Total_Sales) / 1033730.00 * 100), 2) AS revenue_percentage\
FROM omnichannel_sales\
GROUP BY Region\
ORDER BY regional_revenue DESC;\
\
-- Monthly Sales Trend (For week 3)\
-- Finding out how much revenue the business makes on each month \
\
SELECT \
    Month,\
    Month_Name,\
    SUM(Total_Sales) AS monthly_revenue,\
    COUNT(Order_ID) AS total_orders\
FROM omnichannel_sales\
GROUP BY Month, Month_Name\
ORDER BY Month ASC;\
\
--for week 2 sales trend\
\
SELECT \
    Sales_Channel,\
    SUM(Total_Sales) AS channel_revenue,\
    SUM(Quantity) AS items_sold\
FROM omnichannel_sales\
GROUP BY Sales_Channel\
ORDER BY channel_revenue DESC;}